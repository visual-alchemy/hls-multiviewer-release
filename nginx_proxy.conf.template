server {
    listen 80;
    resolver 8.8.8.8;

    # Reverse proxy to Next.js app
    location / {
        proxy_pass http://NEXTJS_UPSTREAM;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Health check endpoint
    location /health {
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    # Segments location
    location ~ ^/([^/]+)/stream/(.*)$ {
        set $akamai_host $1;
        set $segment_path $2;

        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Range, DNT, User-Agent, X-Requested-With, If-Modified-Since, Cache-Control, Content-Type, Authorization' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length, Content-Range, Accept-Ranges' always;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        proxy_set_header Host $akamai_host;
        proxy_set_header Origin "https://www.vidio.com";
        proxy_set_header Referer "https://www.vidio.com";
        proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36 OpsMonitoring";
        proxy_set_header Accept-Encoding "";
        proxy_set_header Range $http_range;
        proxy_set_header Connection "keep-alive";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_pass https://$akamai_host/stream/$segment_path$is_args$args;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_force_ranges on;
        add_header 'Cache-Control' 'no-cache, no-store, must-revalidate' always;
        add_header 'Pragma' 'no-cache' always;
    }

    # Unified location for primary/backup M3U8 filtering - UPDATED REGEX
    location ~ ^/(primary|backup)/([^/]+)(/stream/.+\.(m3u8|mpd))(.*)$ {
        set $stream_type $1;
        set $akamai_host $2;
        set $playlist_path $3;
        set $query_params $5;

        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Range, DNT, User-Agent, X-Requested-With, If-Modified-Since, Cache-Control, Content-Type, Authorization' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length, Content-Range, Accept-Ranges' always;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        proxy_set_header Host $akamai_host;
        proxy_set_header Origin "https://www.vidio.com";
        proxy_set_header Referer "https://www.vidio.com";
        proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36 OpsMonitoring";
        proxy_set_header Accept-Encoding "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_pass https://$akamai_host$playlist_path$is_args$args;

        proxy_buffering off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        add_header 'Cache-Control' 'no-cache, no-store, must-revalidate' always;
        add_header 'Pragma' 'no-cache' always;

        body_filter_by_lua_block {
            if ngx.ctx.buffered == nil then
                ngx.ctx.buffered = ""
            end
            ngx.ctx.buffered = ngx.ctx.buffered .. ngx.arg[1]
            ngx.arg[1] = ""

            if ngx.arg[2] then
                local body = ngx.ctx.buffered
                local stream_type = ngx.var.stream_type
                local akamai_host = ngx.var.akamai_host
                local playlist_path = ngx.var.playlist_path
                local new_body = {}

                -- Debug logging
                ngx.log(ngx.ERR, "===== DEBUG START =====")
                ngx.log(ngx.ERR, "Stream Type: ", stream_type)
                ngx.log(ngx.ERR, "Playlist Path: ", playlist_path)
                ngx.log(ngx.ERR, "Body Length: ", string.len(body))
                ngx.log(ngx.ERR, "Body Content: ", body)

                local lines = {}
                for line in string.gmatch(body, "([^\r\n]*)") do
                    if line ~= "" then
                        table.insert(lines, line)
                    end
                end

                ngx.log(ngx.ERR, "Total Lines: ", #lines)

                -- Check if this is a DRM HLS pattern (contains /drm/hls/)
                if string.find(playlist_path, "/drm/hls/", 1, true) then
                    ngx.log(ngx.ERR, "DRM HLS detected")
                    -- DRM HLS filtering logic
                    local target_stream = (stream_type == "primary") and "hls%-p" or "hls%-b"
                    ngx.log(ngx.ERR, "Target Stream: ", target_stream)

                    for i, line in ipairs(lines) do
                        if string.find(line, "#EXTM3U", 1, true) then
                            table.insert(new_body, line)
                            ngx.log(ngx.ERR, "Added EXTM3U header")
                        elseif string.find(line, "#EXT-X-STREAM-INF", 1, true) then
                            ngx.log(ngx.ERR, "Found STREAM-INF at line ", i, ": ", line)
                            -- Check next non-empty line for target stream
                            for j = i + 1, #lines do
                                if lines[j] ~= "" then
                                    ngx.log(ngx.ERR, "Checking line ", j, ": ", lines[j])
                                    if string.find(lines[j], target_stream, 1) then
                                        ngx.log(ngx.ERR, "MATCH! Adding stream")
                                        table.insert(new_body, line)
                                        table.insert(new_body, lines[j])
                                    else
                                        ngx.log(ngx.ERR, "No match for target: ", target_stream)
                                    end
                                    break
                                end
                            end
                        end
                    end
                else
                    -- Original filtering logic for non-DRM HLS
                    for i, line in ipairs(lines) do
                        if string.find(line, "#EXTM3U", 1, true) or string.find(line, "##", 1, true) or string.find(line, "#EXT-X-INDEPENDENT-SEGMENTS", 1, true) then
                            table.insert(new_body, line)
                        end
                    end

                    if string.find(body, "#EXT%-X%-MEDIA", 1) then
                        local audio_group_id = stream_type .. "-audio"

                        for i, line in ipairs(lines) do
                            if string.find(line, "#EXT-X-MEDIA", 1, true) and string.find(line, 'GROUP-ID="' .. audio_group_id .. '"', 1, true) then
                                table.insert(new_body, line)
                            end
                        end

                        for i, line in ipairs(lines) do
                            if string.find(line, "#EXT-X-STREAM-INF", 1, true) and string.find(line, "RESOLUTION=640x360", 1, true) and string.find(line, 'AUDIO="' .. audio_group_id .. '"', 1, true) and string.find(line, 'CODECS="avc1', 1, true) then
                                table.insert(new_body, line)
                                for j = i + 1, #lines do
                                    if lines[j] ~= "" then
                                        table.insert(new_body, lines[j])
                                        break
                                    end
                                end
                            end
                        end
                    else
                        local target_stream = (stream_type == "primary") and "hls%-p" or "hls%-b"

                        for i, line in ipairs(lines) do
                            if string.find(line, "#EXT-X-STREAM-INF", 1, true) then
                                for j = i + 1, #lines do
                                    if lines[j] ~= "" then
                                        if string.find(lines[j], target_stream, 1) then
                                            table.insert(new_body, line)
                                            table.insert(new_body, lines[j])
                                        end
                                        break
                                    end
                                end
                            end
                        end
                    end
                end

                ngx.arg[1] = table.concat(new_body, "\n") .. "\n"
                ngx.log(ngx.ERR, "Final body length: ", string.len(ngx.arg[1]))
                ngx.log(ngx.ERR, "===== DEBUG END =====")
            end
        }

        sub_filter_types text/plain application/vnd.apple.mpegurl application/x-mpegurl;
        sub_filter_once off;
        sub_filter '/stream/' '/$akamai_host/stream/';
        sub_filter '"/stream/' '"/$akamai_host/stream/';
        sub_filter "'/stream/" "'/$akamai_host/stream/";
    }

    # Unfiltered location
    location ~ ^/([^/]+)(/stream/.+\.(m3u8|mpd))(.*)$ {
        set $akamai_host $1;
        set $playlist_path $2;
        set $query_params $4;

        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Range, DNT, User-Agent, X-Requested-With, If-Modified-Since, Cache-Control, Content-Type, Authorization' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length, Content-Range, Accept-Ranges' always;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        proxy_set_header Host $akamai_host;
        proxy_set_header Origin "https://www.vidio.com";
        proxy_set_header Referer "https://www.vidio.com";
        proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36 OpsMonitoring";
        proxy_set_header Accept-Encoding "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_pass https://$akamai_host$playlist_path$is_args$args;

        proxy_buffering off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        add_header 'Cache-Control' 'no-cache, no-store, must-revalidate' always;
        add_header 'Pragma' 'no-cache' always;

        sub_filter_types text/plain application/vnd.apple.mpegurl application/x-mpegurl;
        sub_filter_once off;
        sub_filter '/stream/' '/$akamai_host/stream/';
        sub_filter '"/stream/' '"/$akamai_host/stream/';
        sub_filter "'/stream/" "'/$akamai_host/stream/";
    }

}