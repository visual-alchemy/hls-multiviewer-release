server {
    listen 80;
    resolver 8.8.8.8;

    # Reverse proxy to Next.js app
    location / {
        proxy_pass http://NEXTJS_UPSTREAM;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Health check endpoint
    location /health {
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    # Main Proxy Location - Handles /primary|backup/:host/stream/...
    location ~ ^/(primary|backup)/([^/]+)(/stream/.*)$ {
        set $stream_type $1;
        set $akamai_host $2;
        set $stream_path $3;

        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Range, DNT, User-Agent, X-Requested-With, If-Modified-Since, Cache-Control, Content-Type, Authorization' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length, Content-Range, Accept-Ranges' always;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        proxy_set_header Host $akamai_host;
        proxy_set_header Origin "https://www.vidio.com";
        proxy_set_header Referer "https://www.vidio.com";
        proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 OpsMonitoring";
        proxy_set_header Accept-Encoding "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_pass https://$akamai_host$stream_path$is_args$args;

        proxy_buffering off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        add_header 'Cache-Control' 'no-cache, no-store, must-revalidate' always;
        add_header 'Pragma' 'no-cache' always;

        body_filter_by_lua_block {
            if ngx.ctx.buffered == nil then ngx.ctx.buffered = "" end
            ngx.ctx.buffered = ngx.ctx.buffered .. ngx.arg[1]
            ngx.arg[1] = ""
            if ngx.arg[2] then
                local host = ngx.var.akamai_host
                local stream_type = ngx.var.stream_type
                local body = ngx.ctx.buffered
                
                -- Robust Rewrite: Handles all line endings (\n, \r\n) and prevents double-prefixing
                local prefix = "/" .. stream_type .. "/" .. host .. "/stream/"
                
                -- 1. Replace all /stream/ with prefixed version
                local res = string.gsub(body, "/stream/", prefix)
                
                -- 2. Collapse any double-prefixes that might have been created
                local double_prefix = "/" .. stream_type .. "/" .. host .. "/" .. stream_type .. "/" .. host .. "/stream/"
                res = string.gsub(res, double_prefix, prefix)
                
                ngx.arg[1] = res
            end
        }
    }

    # Universal Proxy Location - Handles non-prefixed URLs: /:host/stream/...
    location ~ ^/([^/]+)/stream/(.*)$ {
        set $akamai_host $1;
        set $stream_path $2;

        if ($akamai_host ~* "^(primary|backup)$") {
            return 404;
        }

        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Range, DNT, User-Agent, X-Requested-With, If-Modified-Since, Cache-Control, Content-Type, Authorization' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length, Content-Range, Accept-Ranges' always;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        proxy_set_header Host $akamai_host;
        proxy_set_header Origin "https://www.vidio.com";
        proxy_set_header Referer "https://www.vidio.com";
        proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 OpsMonitoring";
        proxy_set_header Accept-Encoding "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_pass https://$akamai_host/stream/$stream_path$is_args$args;

        proxy_buffering off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        add_header 'Cache-Control' 'no-cache, no-store, must-revalidate' always;
        add_header 'Pragma' 'no-cache' always;

        body_filter_by_lua_block {
            local uri = ngx.var.uri
            if string.find(uri, "%.m3u8") or string.find(uri, "%.mpd") then
                if ngx.ctx.buffered == nil then ngx.ctx.buffered = "" end
                ngx.ctx.buffered = ngx.ctx.buffered .. ngx.arg[1]
                ngx.arg[1] = ""
                if ngx.arg[2] then
                    local host = ngx.var.akamai_host
                    local body = ngx.ctx.buffered
                    local prefix = "/" .. host .. "/stream/"
                    
                    -- Robust Rewrite
                    local res = string.gsub(body, "/stream/", prefix)
                    local double_prefix = "/" .. host .. "/" .. host .. "/stream/"
                    res = string.gsub(res, double_prefix, prefix)
                    
                    ngx.arg[1] = res
                end
            end
        }
    }
}